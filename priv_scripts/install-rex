#!/usr/bin/env bash
# Install Rex (superlogical's terminal multiplexer) from its preview appcast.
# There's no Homebrew cask; after the first install the app keeps itself up to
# date through Sparkle.
set -euo pipefail

app=$(find /Applications -maxdepth 1 -name 'Rex*.app' | head -1)

if [[ -z $app ]]; then
    # The appcast URL stays out of this repo; it's exported from ~/.envrc
    if [[ -z ${REX_APPCAST_URL:-} ]]; then
        echo "REX_APPCAST_URL isn't set (add it to ~/.envrc); can't install Rex" >&2
        exit 1
    fi

    tmp=$(mktemp -d)
    trap 'hdiutil detach -quiet "$tmp/mnt" 2>/dev/null || true; rm -rf "$tmp"' EXIT

    # The appcast is stored brotli-compressed but served without a
    # Content-Encoding header, so curl can't decode it by itself
    curl -fsSL -o "$tmp/appcast.xml" "$REX_APPCAST_URL"
    if ! xmllint --noout "$tmp/appcast.xml" 2>/dev/null; then
        brotli -dc "$tmp/appcast.xml" > "$tmp/appcast.decoded"
        mv "$tmp/appcast.decoded" "$tmp/appcast.xml"
    fi
    url=$(xmllint --xpath 'string(//item[1]/enclosure/@url)' "$tmp/appcast.xml")

    echo "Downloading $url"
    curl -fL --progress-bar -o "$tmp/rex.dmg" "$url"
    hdiutil attach -quiet -nobrowse -readonly -mountpoint "$tmp/mnt" "$tmp/rex.dmg"
    src=$(find "$tmp/mnt" -maxdepth 1 -name 'Rex*.app' | head -1)
    cp -R "$src" /Applications/
    app="/Applications/$(basename "$src")"
    echo "Installed $app"
fi

# rex-sessionizer switches the app's session from the CLI, which the app only
# accepts with Remote Control on
defaults write com.superlogical.rex rex.client.remoteControl -bool true

# The agent skill, in the directory Codex, OpenCode and Pi share. Claude Code's
# copy already lives in this repo (claude/skills/rex). Setup isn't run for
# Claude or Codex because it would put back Rex's own session-start hook, which
# tells agents to rename the session.
for rex in "$app"/Contents/Helpers/*/Contents/MacOS/rex; do
    [[ -x $rex ]] && break
done
"$rex" skill setup --agent opencode --agent pi >/dev/null || true

# Codex's session-start hook, through the same wrapper as Claude's
# (claude/settings.json). Codex asks to approve it in /hooks.
if [[ -d ~/.codex ]]; then
    hooks=~/.codex/hooks.json
    [[ -f $hooks ]] || echo '{}' > "$hooks"
    jq --arg cmd "$HOME/.dotfiles/claude/hooks/rex-session-start.sh codex" '
        .hooks.SessionStart = [(.hooks.SessionStart // [])[]
            | select(any(.hooks[]?; .command | test("rex __internal session-start|rex-session-start")) | not)]
        + [{hooks: [{type: "command", command: $cmd, timeout: 5}]}]
    ' "$hooks" > "$hooks.new" && mv "$hooks.new" "$hooks"
fi
